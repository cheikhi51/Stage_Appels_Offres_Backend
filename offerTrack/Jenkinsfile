pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/cheikhi51/Stage_Appels_Offres_Backend.git'
            }
        }

        stage('Build') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                            string(credentialsId: 'jwt-expiration', variable: 'JWT_EXPIRATION'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                set JWT_SECRET=%JWT_SECRET%
                                set JWT_EXPIRATION=%JWT_EXPIRATION%
                                mvn clean compile
                            """
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                            string(credentialsId: 'jwt-expiration', variable: 'JWT_EXPIRATION'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                set JWT_SECRET=%JWT_SECRET%
                                set JWT_EXPIRATION=%JWT_EXPIRATION%
                                mvn test
                            """
                        }
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
              steps {
                  dir('offerTrack') {
                      script {
                          withSonarQubeEnv('MySonnarQubeServer') {
                              bat 'mvn sonar:sonar -Dsonar.projectKey=offertrack-backend'
                          }
                      }
                  }
              }
          }

        stage('Package') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            string(credentialsId: 'jwt-secret', variable: 'JWT_SECRET'),
                            string(credentialsId: 'jwt-expiration', variable: 'JWT_EXPIRATION'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                set JWT_SECRET=%JWT_SECRET%
                                set JWT_EXPIRATION=%JWT_EXPIRATION%
                                mvn package -DskipTests
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Backend pipeline completed successfully!'
        }
        failure {
            echo '❌ Backend pipeline failed.'
        }
        always {
            cleanWs(cleanWhenFailure: true)
        }
    }
}
