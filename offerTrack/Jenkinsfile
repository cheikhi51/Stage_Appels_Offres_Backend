pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main', url: 'https://github.com/cheikhi51/Stage_Appels_Offres_Backend.git'
            }
        }

        stage('Build') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                mvn clean compile
                            """
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                mvn test
                            """
                        }
                    }
                }
            }
        }

        stage('Package') {
            steps {
                dir('offerTrack') {
                    script {
                        withCredentials([
                            string(credentialsId: 'postgres-db-url', variable: 'DB_URL'),
                            usernamePassword(
                                credentialsId: 'postgres-db-credentials',
                                usernameVariable: 'DB_USERNAME',
                                passwordVariable: 'DB_PASSWORD'
                            )
                        ]) {
                            bat """
                                set DB_DRIVER_CLASS_NAME=org.postgresql.Driver
                                set DB_URL=%DB_URL%
                                set DB_USERNAME=%DB_USERNAME%
                                set DB_PASSWORD=%DB_PASSWORD%
                                mvn package -DskipTests
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ Backend pipeline completed successfully!'
        }
        failure {
            echo '❌ Backend pipeline failed.'
        }
        always {
            cleanWs(cleanWhenFailure: true)
        }
    }
}